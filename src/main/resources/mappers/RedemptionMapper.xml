<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.mutualfundinvestmentspringmvc.dao.RedemptionMapper">


    <!-- ========================================================= -->
    <!-- RESULT MAP -->
    <!-- ========================================================= -->

    <resultMap id="redemptionResult"
               type="com.crimsonlogic.mutualfundinvestmentspringmvc.model.financeactivity.Redemption">

        <id property="redemptionId"
            column="redemption_id"/>

        <result property="investorId"
                column="user_id"/>

        <result property="fundId"
                column="fund_id"/>

        <result property="unitsRedeemed"
                column="units_redeemed"/>

        <result property="amount"
                column="amount"/>

        <result property="activityDate"
                column="activity_date"/>

    </resultMap>


    <!-- ========================================================= -->
    <!-- INSERT -->
    <!-- ========================================================= -->

    <insert id="insertRedemption">

        INSERT INTO redemption
        (
        redemption_id,
        user_id,
        fund_id,
        units_redeemed,
        amount,
        activity_date
        )

        VALUES
        (
        #{redemptionId},
        #{investorId},
        #{fundId},
        #{unitsRedeemed},
        #{amount},
        #{activityDate}
        )

    </insert>


    <!-- ========================================================= -->
    <!-- GET BY ID -->
    <!-- ========================================================= -->

    <select id="getRedemptionById"
            resultMap="redemptionResult">

        SELECT
        redemption_id,
        user_id,
        fund_id,
        units_redeemed,
        amount,
        activity_date

        FROM redemption

        WHERE redemption_id = #{redemptionId}

    </select>


    <!-- ========================================================= -->
    <!-- GET BY USER -->
    <!-- ========================================================= -->

    <select id="getRedemptionsByUser"
            resultMap="redemptionResult">

        SELECT
        redemption_id,
        user_id,
        fund_id,
        units_redeemed,
        amount,
        activity_date

        FROM redemption

        WHERE user_id = #{userId}

        ORDER BY activity_date DESC

    </select>


    <!-- ========================================================= -->
    <!-- GET ALL -->
    <!-- ========================================================= -->

    <select id="getAllRedemptions"
            resultMap="redemptionResult">

        SELECT
        redemption_id,
        user_id,
        fund_id,
        units_redeemed,
        amount,
        activity_date

        FROM redemption

        ORDER BY activity_date DESC

    </select>


</mapper>