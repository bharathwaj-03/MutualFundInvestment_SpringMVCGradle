<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.crimsonlogic.mutualfundinvestmentspringmvc.dao.PortfolioMapper">

    <!-- ========================================================= -->
    <!-- RESULT MAP -->
    <!-- ========================================================= -->
    <resultMap id="portfolioResult"
               type="com.crimsonlogic.mutualfundinvestmentspringmvc.model.portfolio.Portfolio">

        <id property="portfolioId"
            column="portfolio_id"/>

        <result property="lastActivityDate"
                column="last_activity_date"/>

        <association property="investor"
                     javaType="com.crimsonlogic.mutualfundinvestmentspringmvc.model.user.Investor"
                     select="com.crimsonlogic.mutualfundinvestmentspringmvc.dao.InvestorMapper.getInvestorByUserId"
                     column="user_id"/>

    </resultMap>

    <!-- ========================================================= -->
    <!-- INSERT -->
    <!-- ========================================================= -->

    <insert id="insertPortfolio">

        INSERT INTO portfolio
        (
        portfolio_id,
        user_id,
        last_activity_date
        )

        VALUES
        (
        #{portfolioId},
        #{investor.userId},
        #{lastActivityDate}
        )

    </insert>

    <!-- ========================================================= -->
    <!-- UPDATE -->
    <!-- ========================================================= -->

    <update id="updatePortfolio">

        UPDATE portfolio

        SET

        last_activity_date=#{lastActivityDate}

        WHERE portfolio_id=#{portfolioId}

    </update>

    <!-- ========================================================= -->
    <!-- DELETE -->
    <!-- ========================================================= -->

    <delete id="deletePortfolio">

        DELETE

        FROM portfolio

        WHERE portfolio_id=#{portfolioId}

    </delete>

    <!-- ========================================================= -->
    <!-- SEARCH BY PORTFOLIO ID -->
    <!-- ========================================================= -->

    <select id="getPortfolioById"
            resultMap="portfolioResult">

        SELECT *

        FROM portfolio

        WHERE portfolio_id=#{portfolioId}

    </select>

    <!-- ========================================================= -->
    <!-- SEARCH BY USER -->
    <!-- ========================================================= -->

    <select id="getPortfolioByUserId"
            resultMap="portfolioResult">

        SELECT
        portfolio_id,
        user_id,
        last_activity_date
        FROM portfolio
        WHERE user_id = #{userId}

    </select>

    <!-- ========================================================= -->
    <!-- GET ALL PORTFOLIOS -->
    <!-- ========================================================= -->

    <select id="getAllPortfolios"
            resultMap="portfolioResult">

        SELECT *

        FROM portfolio

        ORDER BY portfolio_id

    </select>

</mapper>